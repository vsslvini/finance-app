# Copie este arquivo para .env e preencha com os valores reais.
# O .env nunca vai para o git; este exemplo vai, sem valores secretos.

# PostgreSQL (usado pelo docker-compose e pelo Django)
POSTGRES_DB=app_financas
POSTGRES_USER=app_financas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
# Endereços aceitos pelo Django, separados por vírgula e sem espaços; para o
# celular, incluir o IP do computador na rede local
# (ex.: localhost,127.0.0.1,192.168.0.10)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Pluggy (credenciais do Meu Pluggy)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
