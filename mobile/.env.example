# Copie este arquivo para mobile/.env (o .env não vai para o git) e preencha.
#
# EXPO_PUBLIC_API_URL: endereço do backend Django. Use o IP do computador na
# rede (não "localhost", que no celular aponta para o próprio celular) e a
# porta 8000.
#
# EXPO_PUBLIC_API_TOKEN: o token criado no backend com
# `python manage.py drf_create_token <usuário>`.
#
# Atenção: variáveis EXPO_PUBLIC_ ficam visíveis dentro do app, em texto puro.
# Risco aceito para uso pessoal (decisão de 2026-10-04); o token vai depois
# para o expo-secure-store. Nunca coloque aqui chaves da Pluggy ou senhas.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
EXPO_PUBLIC_API_TOKEN=
